.agents/
skills-lock.json

# gstack is a bundled skill collection cloned by `skillquarium install --extras gstack`.
# 250MB+ with its own .git — not commitable. The installer clones it fresh and
# runs its ./setup to symlink the bundle into each agent.
# Sub-skill wrappers and per-host skill folders are generated only when
# gstack/ is installed; they come and go with the install state.
#
# Patterns cover both the skill folders and the generated `<name>.md` wrapper
# notes. `/gstack-*` already catches `gstack-qa/` and `gstack-qa.md`; the
# underscore-prefixed install artifacts need their own pattern because the
# leading `_` puts them outside it, and the bare `gstack.md` wrapper needs one
# because it has no hyphen to match.
#
# The skill folders live under `/skills/`; the generated wrapper notes live in
# the human layer under `/vault/notes/<domain>/`. Both roots need the patterns.
# `/gstack/` also covers the empty extras stub the installer keeps beside
# `skills/`.
/gstack/
/gstack-*
/_gstack*
/skills/gstack/
/skills/gstack-*
/skills/_gstack*
/vault/notes/*/gstack.md
/vault/notes/*/gstack-*.md
/vault/notes/*/_gstack*.md

# UI/UX Pro Max is a seven-skill bundle generated by its pinned upstream CLI.
# The installer owns these local folders; repository history owns only the
# integration helper, tests, and documentation.
/skills/.ui-ux-pro-max-managed
/skills/ui-ux-pro-max/
/skills/banner-design/
/skills/brand/
/skills/design-system/
/skills/design/
/skills/slides/
/skills/ui-styling/
/vault/notes/*/ui-ux-pro-max.md
/vault/notes/*/banner-design.md
/vault/notes/*/brand.md
/vault/notes/*/design-system.md
/vault/notes/*/design.md
/vault/notes/*/slides.md
/vault/notes/*/ui-styling.md

