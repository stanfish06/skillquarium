#!/bin/sh
set -eu
VAULT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
PKG_DIR="$VAULT_DIR/.skill-vault"
STAMP="$PKG_DIR/node_modules/.bun-install-stamp"
command -v bun >/dev/null 2>&1 || { echo "skillquarium: bun is required (https://bun.sh)" >&2; exit 2; }
# Reinstall when node_modules is missing or bun.lock changed since the last install.
if [ ! -d "$PKG_DIR/node_modules/@opentui/core" ] || [ ! -e "$STAMP" ] || [ "$PKG_DIR/bun.lock" -nt "$STAMP" ]; then
  # bun.lock is lockfileVersion 2; a Bun too old to read it fails here with a bare parse error.
  if ! bun install --frozen-lockfile --cwd "$PKG_DIR" >/dev/null 2>"$PKG_DIR/.bun-install.err"; then
    echo "skillquarium: bun install failed (bun $(bun --version)). The lockfile is lockfileVersion 2;" >&2
    echo "  if the error below mentions the lockfile version, upgrade Bun (bun upgrade); CI uses 1.4.2." >&2
    sed 's/^/  /' "$PKG_DIR/.bun-install.err" >&2
    rm -f "$PKG_DIR/.bun-install.err"
    exit 2
  fi
  rm -f "$PKG_DIR/.bun-install.err"
  touch "$STAMP"
fi
exec bun "$PKG_DIR/src/cli.ts" --root "$VAULT_DIR" "$@"
