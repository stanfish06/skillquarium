#!/bin/sh
set -eu

VAULT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
BACKEND=false
SKIP_NEXT=false
for ARG in "$@"; do
  if [ "$SKIP_NEXT" = true ]; then
    SKIP_NEXT=false
    continue
  fi
  case "$ARG" in
    --root|--query)
      SKIP_NEXT=true
      ;;
    --root=*|--query=*)
      ;;
    list|catalog|preview|enable|disable|toggle|save|load|pre-commit-reset|-h|--help)
      BACKEND=true
      break
      ;;
  esac
done

if [ "$BACKEND" = true ]; then
  exec python3 "$VAULT_DIR/.skill-vault/skill_toggle.py" "$@"
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "skillquarium: Bun is required for the OpenTUI interface (https://bun.sh)" >&2
  exit 2
fi

TUI_DIR="$VAULT_DIR/.skill-vault/tui"
if [ ! -d "$TUI_DIR/node_modules/@opentui/core" ]; then
  bun install --cwd "$TUI_DIR" --frozen-lockfile >/dev/null
fi

exec bun "$TUI_DIR/index.ts" --root "$VAULT_DIR" "$@"
