#!/bin/sh
set -eu
VAULT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
command -v bun >/dev/null 2>&1 || { echo "skillquarium: bun is required (https://bun.sh)" >&2; exit 2; }
[ -d "$VAULT_DIR/.skill-vault/node_modules/@opentui/core" ] || bun install --cwd "$VAULT_DIR/.skill-vault" --frozen-lockfile >/dev/null
exec bun "$VAULT_DIR/.skill-vault/src/cli.ts" --root "$VAULT_DIR" "$@"
